{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Guitar Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#0b0c10",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../target/plugin/": "plugins/",
      "../licenses/": "licenses/",
      "../LICENSE": "licenses/LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
